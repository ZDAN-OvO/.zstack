/embeddings/Microsoft_Excel_Sheet3.xlsxPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]syЅ�\u0002\u0000\u0000{\u0005\u0000\u0000\u001f\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001m�\u0000\u0000ppt/notesSlides/notesSlide6.xmlPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]>)�u�\u0000\u0000\u0000�\u0001\u0000\u0000*\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u00019�\u0000\u0000ppt/notesSlides/_rels/notesSlide6.xml.relsPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj].\u0016�Z�\t\u0000\u0000\nY\u0000\u0000\u0015\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001O�\u0000\u0000ppt/slides/slide7.xmlPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]��\u0014��\u0000\u0000\u0000�\u0001\u0000\u0000 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001p\t\u0001\u0000ppt/slides/_rels/slide7.xml.relsPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]��Cʫ\u0002\u0000\u0000�\u0005\u0000\u0000\u001f\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001\n\u0001\u0000ppt/notesSlides/notesSlide7.xmlPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]\u0019L���\u0000\u0000\u0000�\u0001\u0000\u0000*\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001g\n\u0001\u0000ppt/notesSlides/_rels/notesSlide7.xml.relsPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]f�\u001a��\n\u0000\u0000[}\u0000\u0000\u0015\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001}\u000e\u0001\u0000ppt/slides/slide8.xmlPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]\u0000�\u0001S�\u0000\u0000\u0000�\u0001\u0000\u0000 \u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000\u0000�\u0001w\u0019\u0001\u0000ppt/slides/_rels/slide8.xml.relsPK\u0001\u0002\u0014\u0003\u0014\u0000\u0000\u0000\b\u0000ɐj]D�(\b\u0002\u0000\u0000Y\u0005\u0000\u0000\u001f\u0000\u0000\u0000\u0000\u0